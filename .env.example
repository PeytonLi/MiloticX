# Copy this file to .env and fill in your values. NEVER commit .env.

# ---- Model provider (TrueForge: Settings -> Models) ----
# Any OpenAI-compatible endpoint works. Examples below; use one.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: DeepSeek (cheap for dev)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- GitHub MCP connector (public repos: read + fork + open PR) ----
# Fine-grained PAT, scoped to public repos only.
GITHUB_TOKEN=

# ---- Sandbox provider (TrueForge: Settings -> Sandbox providers) ----
# Daytona API key.
DAYTONA_API_KEY=
DAYTONA_SERVER_URL=https://app.daytona.io/api

# ---- MCP server (npm run start:server) ----
# Comma-separated hostnames allowed for the MCP server's DNS-rebinding protection.
# Default: localhost,127.0.0.1,host.docker.internal
# Set to '*' to disable validation (e.g. behind a Render/Heroku proxy).
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# ---- Optional: verification ledger (incremental verification) ----
# JSON file where the MCP server stores per-repo README fingerprints + results.
LEDGER_PATH=./ledger.json
